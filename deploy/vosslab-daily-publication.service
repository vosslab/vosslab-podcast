[Unit]
Description=Vosslab date-owned daily blog generator and local importer
Documentation=file:///home/vosslab/nsh/vosslab-podcast/docs/DAILY_BLOG_OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/vosslab/nsh/vosslab-podcast
Environment=TZ=America/Chicago
Environment=HERMES_HOME=/home/vosslab/.hermes
Environment=PATH=/home/vosslab/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/vosslab/nsh/vosslab-podcast/make_blog.py --yesterday
TimeoutStartSec=4h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/vosslab/nsh/vosslab-podcast /home/vosslab/nsh/vosslab-daily-blog /home/vosslab/repo-mirrors/vosslab /home/vosslab/.hermes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
